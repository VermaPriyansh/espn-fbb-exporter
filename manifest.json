{
  "manifest_version": 3,
  "name": "ESPN Fantasy Basketball Data Exporter",
  "version": "3.2.0",
  "description": "Exports ESPN Fantasy Basketball league data for the Fantasy Basketball Optimizer.",
  "action": {
    "default_popup": "html/popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "*://*.espn.com/*",
    "*://*.fantasy.espn.com/*",
    "https://lm-api-reads.fantasy.espn.com/*",
    "*://*.streamlit.app/*",
    "http://localhost:8501/*",
    "http://localhost:8080/*",
    "https://*.run.app/*",
    "*://*.run.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.streamlit.app/*",
        "http://localhost:8501/*",
        "http://localhost:8080/*",
        "https://*.run.app/*",
        "*://*.run.app/*"
      ],
      "js": ["js/content_streamlit.js"],
      "run_at": "document_idle"
    }
  ]
}
